{
  "name": "sunglow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@vercel/analytics": "^1.6.1",
    "drizzle-orm": "^0.45.2",
    "suncalc": "^1.9.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.9.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
